{
  "family": "publication-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/publicationServiceTaskRole",
  "containerDefinitions": [
    {
      "name": "publication-service",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/publication-service:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8083,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "SERVER_PORT", "value": "8083" },
        { "name": "DB_URL", "value": "jdbc:mariadb://<RDS_ENDPOINT>:3306/db_listings" },
        { "name": "DB_USERNAME", "value": "root" }
      ],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/publication-service/db-password"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:8083/actuator/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/publication-service",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "publication-service"
        }
      }
    }
  ]
}
