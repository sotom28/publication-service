SPRING_PROFILES_ACTIVE=prod

# --- Servidor (EC2 en VPC / subnet privada) ---
# IP a la que se bindea el microservicio. 0.0.0.0 = escucha en todas las
# interfaces (recomendado si hay ALB/ingress interno). Para restringir, usar
# la IP privada de la instancia.
SERVER_IP=0.0.0.0
SERVER_PORT=8083

# --- Base de datos (misma EC2 por ahora) ---
# Si la BD corre en la misma instancia se usa 127.0.0.1 o la IP privada.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_listings
DB_USER=svc_listings
DB_PASSWORD=changeme

# --- AWS (S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=